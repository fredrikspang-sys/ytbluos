<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS LaunchAgent. Edit the two paths, then:
     cp ytbluos.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/ytbluos.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ytbluos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/ytbluos/ytbluos.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/ytbluos.log</string>
  <key>StandardErrorPath</key><string>/tmp/ytbluos.log</string>
</dict>
</plist>
